<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DAM_Practica02.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DAM_Practica02"
    xmlns:views="clr-namespace:DAM_Practica02.Views"
    Shell.FlyoutBehavior="Flyout"
    BackgroundColor="{DynamicResource Background}"
    ForegroundColor="{DynamicResource PrimaryDark}"
    FlyoutBackgroundColor="{DynamicResource Background}"
    Shell.TitleColor="{DynamicResource PrimaryDark}"
    
    Title="DAM_Practica02">

    <FlyoutItem 
        Title="Home"
        Route="MainPage">
        <ShellContent
            ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>
    <FlyoutItem 
        Title="Gallery"
        Route="Gallery">
        <ShellContent
            ContentTemplate="{DataTemplate views:Gallery}" />
    </FlyoutItem>
    <FlyoutItem 
        Title="Settings"
        Route="Settings">
        <ShellContent
            ContentTemplate="{DataTemplate views:Settings}" />
    </FlyoutItem>
</Shell>
