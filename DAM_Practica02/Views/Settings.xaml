<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DAM_Practica02.Views.Settings"
             Title="Settings"
             BackgroundColor="{DynamicResource Background}">
    <ScrollView>
        <VerticalStackLayout>
            <Label 
                Text="Settings"
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                Style= "{StaticResource PrimaryTextStyle}"/>
        
            <Label 
                Text="Titles"
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                Style= "{StaticResource SecondaryTextStyle}"/>
        
            <Label 
                Text="Font"
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                Style= "{StaticResource TertiaryTextStyle}"/>
            <Picker 
                Title="{DynamicResource PrimaryFontFamily}"
                WidthRequest="200"
                SelectedIndexChanged="OnPrimaryFontChanged">
                <Picker.Items>
                    <x:String>Open Sans</x:String>
                    <x:String>Arial</x:String>
                    <x:String>Courier New</x:String>
                    <x:String>Times New Roman</x:String>
                </Picker.Items>
            </Picker>
        
            <Label 
                Text="Size"
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                Style= "{StaticResource TertiaryTextStyle}"/>
            <Slider
                VerticalOptions="Center"
                HorizontalOptions="Center"
                WidthRequest="200"
                Minimum="18"
                Maximum="100"
                ValueChanged="OnPrimaryFontSizeSliderValueChanged"/>
        
            <Label 
                Text="Color"
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                Style= "{StaticResource TertiaryTextStyle}"/>
            <Picker 
                Title="{DynamicResource PrimaryDark}"
                WidthRequest="200"
                SelectedIndexChanged="OnPrimaryColorChanged">
                <Picker.Items>
                    <x:String>Yellow</x:String>
                    <x:String>Pink</x:String>
                    <x:String>Blue</x:String>
                    <x:String>Purple</x:String>
                    <x:String>Red</x:String>
                    <x:String>White</x:String>
                </Picker.Items>
            </Picker>
        
            <Label 
                Text="Headers"
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                Style= "{StaticResource SecondaryTextStyle}"/>

            <Label 
                Text="Color"
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                Style= "{StaticResource TertiaryTextStyle}"/>
            <Picker 
                Title="{DynamicResource SecondaryFontFamily}"
                WidthRequest="200"
                SelectedIndexChanged="OnSecondaryFontChanged">
                <Picker.Items>
                    <x:String>Open Sans</x:String>
                    <x:String>Arial</x:String>
                    <x:String>Courier New</x:String>
                    <x:String>Times New Roman</x:String>
                </Picker.Items>
            </Picker>
        
            <Label 
                Text="Size"
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                Style= "{StaticResource TertiaryTextStyle}"/>
            <Slider
                VerticalOptions="Center"
                HorizontalOptions="Center"
                WidthRequest="200"
                Minimum="18"
                Maximum="100"
                ValueChanged="OnSecondaryFontSizeSliderValueChanged"/>
        
            <Label 
                Text="Color"
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                Style= "{StaticResource TertiaryTextStyle}"/>
            <Picker 
                Title="{DynamicResource SecondaryDarkText}"
                WidthRequest="200"
                SelectedIndexChanged="OnSecondaryColorChanged">
                <Picker.Items>
                    <x:String>Yellow</x:String>
                    <x:String>Pink</x:String>
                    <x:String>Blue</x:String>
                    <x:String>Purple</x:String>
                    <x:String>Red</x:String>
                    <x:String>White</x:String>
                </Picker.Items>
            </Picker>
        
            <Label 
                Text="Body"
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                Style= "{StaticResource SecondaryTextStyle}"/>

            <Label 
                Text="Color"
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                Style= "{StaticResource TertiaryTextStyle}"/>
            <Picker 
                Title="{DynamicResource TertiaryFontFamily}"
                WidthRequest="200"
                SelectedIndexChanged="OnTertiaryFontChanged">
                <Picker.Items>
                    <x:String>Open Sans</x:String>
                    <x:String>Arial</x:String>
                    <x:String>Courier New</x:String>
                    <x:String>Times New Roman</x:String>
                </Picker.Items>
            </Picker>

            <Label 
                Text="Size"
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                Style= "{StaticResource TertiaryTextStyle}"/>
            <Slider
                VerticalOptions="Center"
                HorizontalOptions="Center"
                WidthRequest="200"
                Minimum="18"
                Maximum="100"
                ValueChanged="OnTertiaryFontSizeSliderValueChanged"/>
            <Label 
                Text="Color"
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                Style= "{StaticResource TertiaryTextStyle}"/>
            <Picker 
                Title="{DynamicResource TertiaryDarkText}"
                WidthRequest="200"
                SelectedIndexChanged="OnTertiaryColorChanged">
                <Picker.Items>
                    <x:String>Yellow</x:String>
                    <x:String>Pink</x:String>
                    <x:String>Blue</x:String>
                    <x:String>Purple</x:String>
                    <x:String>Red</x:String>
                    <x:String>White</x:String>
                </Picker.Items>
            </Picker>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>