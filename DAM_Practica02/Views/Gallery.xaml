<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DAM_Practica02.Views.Gallery"
             Title="Gallery"
             BackgroundColor="{DynamicResource Background}">
    <ScrollView>
        <VerticalStackLayout>
            <Label 
                Text="Gallery"
                VerticalOptions="Center" 
                HorizontalOptions="Center" 
                Style= "{DynamicResource PrimaryTextStyle}"/>
            <FlexLayout Wrap="Wrap">
                <ImageButton
                    Source="buitre_leonado.jpg"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    FlexLayout.Basis="50%"
                    HeightRequest="150"
                    Aspect="AspectFill"
                    Clicked="OnGriffonVultureClicked"/>
                <ImageButton
                    Source="chimpance.jpg"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    FlexLayout.Basis="50%"
                    HeightRequest="150"
                    Aspect="AspectFill"
                    Clicked="OnChimpanzeeClicked"/>
                <ImageButton
                    Source="elephant.jpg"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    FlexLayout.Basis="50%"
                    HeightRequest="150"
                    Aspect="AspectFill"
                    Clicked="OnAfricanElephantClicked"/>
                <ImageButton
                    Source="lion.jpg"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    FlexLayout.Basis="50%"
                    HeightRequest="150"
                    Aspect="AspectFill"
                    Clicked="OnLionClicked"/>
                <ImageButton
                    Source="zebra.jpg"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    FlexLayout.Basis="50%"
                    HeightRequest="150"
                    Aspect="AspectFill"
                    Clicked="OnZebraClicked"/>
            </FlexLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>